{
  "name": "masters-timer",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc && npm run copy-public",
    "watch": "tsc --watch",
    "copy-public": "node -e \"require('fs').cpSync('public','docs',{recursive:true})\"",
    "clean": "node -e \"require('fs').rmSync('docs',{recursive:true,force:true})\"",
    "dev": "npm run build && npm run watch",
    "start": "npm run dev",
    "serve": "npx serve docs"
  },
  "keywords": [],
  "author": "d4nin3u",
  "license": "MIT",
  "description": "",
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
